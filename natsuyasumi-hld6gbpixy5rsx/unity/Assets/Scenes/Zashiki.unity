  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Npc
  who: "\u99C4\u304C\u3057\u3084\u306E \u304A\u3070\u3061\u3083\u3093"
  range: 2.6
  lines:
  - "\u3044\u3089\u3063\u3057\u3083\u3044\u3002\u2026\u2026\u3042\u3093\u305F\u3001\u5C71\u306E
    \u4E0A\u306E \u5BB6\u306E \u5B50\u304B\u3044"
  - "\u30E9\u30E0\u30CD\u306F \u3088\u304F \u51B7\u3048\u3066\u308B\u3088\u3002\u4E95\u6238\u306B
    \u3064\u3051\u3066 \u3042\u308B\u304B\u3089\u306D"
  - "\u305D\u306E \u3080\u3057\u304B\u3054\u3001\u3061\u3044\u3055\u3044\u306D\u3048\u3002\u3046\u3061\u306B
    \u5927\u304D\u3044\u306E\u304C \u3042\u308B\u3088"
  - "\u3053\u306E \u3078\u3093\u306E \u5B50\u306F \u307F\u3093\u306A \u3053\u3053\u306B
    \u6765\u308B\u3002\u590F\u3060\u3051 \u3060\u3051\u3069\u306D"
  - "\u304D\u3087\u3046\u306F \u6691\u3044\u304B\u3089\u3001\u30A2\u30A4\u30B9\u304C
    \u3088\u304F \u51FA\u308B\u3088"
  linesJo:
  - "\u3044\u3089\u3063\u3057\u3083\u3044\u3002\u2026\u2026\u3042\u3093\u305F\u3001\u5C71\u306E
    \u4E0A\u306E \u5BB6\u306E \u5B50\u304B\u3044"
  - "\u30E9\u30E0\u30CD\u306F \u3088\u304F \u51B7\u3048\u3066\u308B\u3088\u3002\u4E95\u6238\u306B
    \u3064\u3051\u3066 \u3042\u308B\u304B\u3089\u306D"
  - "\u305D\u306E \u3080\u3057\u304B\u3054\u3001\u3061\u3044\u3055\u3044\u306D\u3048\u3002\u3046\u3061\u306B
    \u5927\u304D\u3044\u306E\u304C \u3042\u308B\u3088"
  - "\u3053\u306E \u3078\u3093\u306E \u5B50\u306F \u307F\u3093\u306A \u3053\u3053\u306B
    \u6765\u308B\u3002\u590F\u3060\u3051 \u3060\u3051\u3069\u306D"
  - "\u304D\u3087\u3046\u306F \u6691\u3044\u304B\u3089\u3001\u30A2\u30A4\u30B9\u304C
    \u3088\u304F \u51FA\u308B\u3088"
  linesChu:
  - "\u304D\u3087\u3046\u306F \u3057\u305A\u304B\u3060\u306D\u3048\u3002\u796D\u308A\u304C
    \u7D42\u308F\u308B\u3068 \u3053\u3093\u306A \u3082\u3093\u3060\u3088"
  - "\u3046\u3061\u306E \u5B50\u3082 \u3080\u304B\u3057\u306F \u6BCE\u65E5 \u6765\u305F\u3088\u3002\u3044\u307E\u306F
    \u753A\u306B \u51FA\u3066\u308B"
  - "\u30A2\u30A4\u30B9\u3001\u305D\u308D\u305D\u308D \u4ED5\u5165\u308C\u304C \u3078\u308B\u304B\u3089\u306D\u3002\u8CB7\u3046\u306A\u3089
    \u3044\u307E \u3060\u3088"
  linesGe:
  - "\u3042\u3093\u305F\u3001\u3082\u3046 \u5E30\u308B\u3093\u3060\u308D\u3002\u2026\u2026\u3055\u307F\u3057\u304F
