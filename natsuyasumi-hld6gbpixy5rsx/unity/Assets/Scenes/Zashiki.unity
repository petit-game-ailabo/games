  mushiHakase: 0
  nigasu:
  - "\u2026\u2026\u3042\u308A\u304C\u3068\u3046 \u3054\u3056\u3044\u307E\u3059\u3002\u3061\u3087\u3063\u3068\u3001\u3046\u308C\u3057\u3044\u3067\u3059"
