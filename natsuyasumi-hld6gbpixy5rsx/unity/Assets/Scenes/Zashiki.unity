    \u3053\u308D \u866B\u3092 \u3068\u3063\u3066 \u3044\u305F\u3088"
  - "\u3053\u3053\u3089\u306F \u6C34\u304C \u3046\u307E\u3044\u3002\u305D\u308C\u3060\u3051\u304C
    \u3058\u307E\u3093 \u3060\u3088"
  - "\u7E01\u5074\u306E \u3044\u305F\u304C \u304D\u3057\u3080 \u3060\u308D\u3002\u3042\u308C\u306F
    \u3058\u3044\u3055\u3093\u304C \u76F4\u3057\u305D\u3053\u306D\u305F \u3068\u3053"
  linesChu:
  - "\u3082\u3046 \u534A\u5206 \u3059\u304E\u305F\u306D\u3048\u3002\u306F\u3084\u3044
    \u3082\u3093\u3060"
  - "\u305D\u308D\u305D\u308D \u65E5\u304C \u307F\u3058\u304B\u304F \u306A\u3063\u3066
    \u304F\u308B\u3088"
  - "\u3042\u3093\u305F\u3001\u3088\u304F \u65E5\u306B \u3084\u3051\u305F\u306D\u3048\u3002\u3061\u3083\u3093\u3068
    \u5E30\u3063\u3066 \u304D\u3066 \u3048\u3089\u3044"
  - "\u3070\u3042\u3061\u3083\u3093\u304C \u5B50\u3069\u3082\u306E \u3053\u308D\u306F\u3001\u5DDD\u3067
    \u6CF3\u3044\u3067\u3082 \u6012\u3089\u308C\u306A\u304B\u3063\u305F\u3088"
  - "\u3046\u3061\u306E \u4E95\u6238\u306F\u306D\u3001\u3072\u3067\u308A\u306E \u5E74\u3067\u3082
    \u304B\u308C\u305F \u3053\u3068\u304C \u306A\u3044\u3093\u3060\u3088"
  - "\u591C\u306B \u306A\u308B\u3068 \u5C71\u304B\u3089 \u98A8\u304C \u304A\u308A\u3066
    \u304F\u308B\u3002\u3042\u308C\u3067 \u3059\u305A\u3057\u304F \u306A\u308B"
  linesGe:
  - "\u3082\u3046 \u3059\u3050 \u5E30\u308B\u3093\u3060\u306D\u3048\u3002\u2026\u2026\u306A\u3093\u3060\u304B
    \u3055\u307F\u3057\u3044\u3088"
  - "\u3042\u3093\u305F\u306E \u3076\u3093\u306E \u3075\u3068\u3093\u3001\u307E\u3060
    \u3057\u3070\u3089\u304F \u51FA\u3057\u3066 \u304A\u3053\u3046\u304B\u306D"
  - "\u590F\u306E \u304A\u308F\u308A\u306F\u3001\u3044\u3064\u3082 \u304D\u3085\u3046\u306B
    \u6765\u308B \u3093\u3060\u3088"
  - "\u3080\u3057\u306E \u58F0\u304C \u5909\u308F\u3063\u305F\u308D\u3002\u3082\u3046
    \u79CB\u306E \u866B\u3060\u3088"
  - "\u6765\u5E74\u3082 \u304A\u3044\u3067\u3002\u3070\u3042\u3061\u3083\u3093\u3001\u307E\u3060
    \u5143\u6C17\u3067 \u3044\u308B\u304B\u3089\u306D"
  - "\u5199\u771F\u3001\u3068\u3063\u3066 \u304A\u3051\u3070 \u3088\u304B\u3063\u305F\u306D\u3048"
  morning:
  - "\u304A\u306F\u3088\u3046\u3002\u3054\u306F\u3093\u3001\u53F0\u6240\u306B \u3042\u308B\u304B\u3089\u306D"
  night:
  - "\u3082\u3046 \u9045\u3044 \u3088\u3002\u306F\u3084\u304F \u304A\u3084\u3059\u307F"
  rain:
  - "\u96E8\u3060\u306D\u3048\u3002\u304D\u3087\u3046\u306F \u5BB6\u3067 \u3086\u3063\u304F\u308A
    \u3057\u306A\u3055\u3044"
  manyBugs:
  - "\u307E\u3042 \u305F\u304F\u3055\u3093 \u3068\u3063\u305F\u306D\u3002\u304B\u3054\u304C
    \u3044\u3063\u3071\u3044 \u3058\u3083\u306A\u3044\u304B"
  mushi:
  - "\u304A\u3084\u3001{0}\u304B\u3044\u3002\u3088\u304F \u3068\u308C\u305F\u306D\u3048"
  - "\u307E\u3042 \u7ACB\u6D3E\u306A {0}\u3002\u3058\u3044\u3055\u3093\u3082 \u3088\u304F
    \u3068\u3063\u3066 \u304D\u305F\u3088"
  - "{0}\u304B\u3044\u3002\u2026\u2026\u306B\u304C\u3057\u3066 \u3084\u308A\u306A\u3088\u3001\u304B\u308F\u3044\u305D\u3046\u3060\u304B\u3089"
  mushiHakase: 0
  nigasu:
  - "\u305D\u3046\u304B\u3044\u3002\u306B\u304C\u3057\u3066 \u3084\u3063\u305F\u304B\u3044\u3002\u2026\u2026\u3084\u3055\u3057\u3044
    \u5B50\u3060\u306D"
  kozukai: 200
  fromDay: 0
  akeru: 0
  shimeru: 0
  player: {fileID: 1442631978}
  hud: {fileID: 1967503402}
  nikki: {fileID: 573846675}
  tod: {fileID: 1090292604}
  weather: {fileID: 1658284813}
  book: {fileID: 1442631970}
  posAsa: {x: 6, y: 0.02, z: 0}
  posHiru: {x: -9.4, y: 0.02, z: 6.55}
  posYoru: {x: -4.125, y: 0.02, z: 3.45}
  hasMoves: 1
  hideOnRain: 0
  koto: 0
  kotoYokoku:
  - "\u3042\u3055\u3063\u3066\u306F \u796D\u308A\u3060\u3088\u3002\u3086\u304B\u305F\u3001\u51FA\u3057\u3066
    \u304A\u3044\u305F\u304B\u3089\u306D"
  kotoMatsuri:
  - "\u3088\u304F \u6765\u305F\u306D\u3002\u306F\u3044\u3001\u3053\u308C \u5C0F\u3065\u304B\u3044\u3002\u5C4B\u53F0\u3067
    \u4F55\u304B \u304A\u3042\u304C\u308A"
  kotoToro: []
  kotoTaifu:
  - "\u304D\u3087\u3046\u306F \u51FA\u3061\u3083 \u3044\u3051\u306A\u3044\u3088\u3002\u98A8\u304C
    \u3064\u3088\u3044 \u304B\u3089\u306D"
  kotoShukudai:
  - "\u5BBF\u984C\u306F \u3084\u3063\u305F\u306E\u304B\u3044\u3002\u2026\u2026\u307E\u3060
    \u306A\u3093\u3060\u308D\u3001\u305D\u306E \u9854\u306F"
  kotoOwakare:
  - "\u3082\u3046 \u5E30\u308B\u306E\u304B\u3044\u3002\u2026\u2026\u307E\u305F \u6765\u5E74
    \u304A\u3044\u3067"
  kotoYoimiya:
  - "\u304D\u3087\u3046\u306F \u5BB5\u5BAE\u3060\u3088\u3002\u3042\u3057\u305F\u304C
    \u672C\u756A \u3060\u3051\u3069\u306D"
  kotoAto:
  - "\u796D\u308A\u306F \u7D42\u308F\u3063\u305F\u306D\u3048\u3002\u2026\u2026\u590F\u3082\u3001\u3082\u3046
    \u3059\u3050 \u304A\u308F\u308A \u3060\u3088"
  kotoYokan:
  - "\u306E\u3053\u308A 4\u65E5 \u304B\u3044\u3002\u306F\u3084\u3044\u3082\u3093\u3060\u306D\u3048"
  kotoOmiyage:
  - "\u304A\u307F\u3084\u3052\u3001\u306A\u306B\u304C \u3044\u3044\uFF1F \u2026\u2026\u8003\u3048\u3066
    \u304A\u3044\u3067"
  kotoSaigo:
  - "\u304D\u3087\u3046\u3067 \u3055\u3044\u3054\u3060\u306D\u3002\u5915\u304C\u305F\u3001\u7E01\u5074\u306B
    \u304A\u3044\u3067"
