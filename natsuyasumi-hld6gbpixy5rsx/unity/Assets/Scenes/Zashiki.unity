  - "{0}\u3060\u306A\u3002\u304A\u308C\u304C \u5B50\u3069\u3082\u306E \u3053\u308D\u306F
    \u3082\u3063\u3068 \u5927\u304D\u3044\u306E\u304C \u3044\u305F \u305E"
