  - "\u5C71\u306E \u4E0A\u307E\u3067 \u884C\u304F\u306A\u3089\u3001\u65E5\u304C \u304F\u308C\u308B
    \u524D\u306B \u5E30\u308C\u3088"
  - "\u3053\u306E \u3078\u3093\u306F \u30AB\u30D6\u30C8\u30E0\u30B7\u304C \u591A\u3044\u3002\u96D1\u6728\u6797\u3092
    \u3055\u304C\u3057\u3066 \u307F\u308D"
  - "\u671D\u306F\u3084\u3044\u306E\u306F \u3048\u3089\u3044\u305E\u3002\u866B\u3082
    \u4EBA\u3082\u3001\u65E9\u3044\u306E\u304C \u52DD\u3061\u3060"
  - "\u8C37\u306E \u304A\u304F\u306E \u753A\u307E\u3067 \u884C\u304F\u306A\u3089\u3001\u6C34\u7B52
    \u6301\u3063\u3066 \u3044\u3051\u3088"
  linesChu:
  - "\u305D\u308D\u305D\u308D \u7A32\u306E \u7A42\u304C \u51FA\u308B \u3053\u308D\u3060\u3002\u3088\u304F
    \u898B\u3066 \u307F\u308D"
  - "\u5915\u7ACB\u304C \u6765\u305D\u3046\u306A \u65E5\u306F\u3001\u96F2\u306E \u5E95\u304C
    \u5E73\u3089\u306B \u306A\u308B"
  - "\u5DDD\u306E \u6C34\u304C \u3064\u3081\u305F\u304F \u306A\u3063\u3066 \u304D\u305F\u3002\u3082\u3046
    \u6CF3\u3050 \u5B63\u7BC0\u3058\u3083 \u306A\u3044\u306A"
  - "\u304A\u308C\u3082 \u5B50\u3069\u3082\u306E \u3053\u308D\u3001\u3053\u3053\u3067
    \u3055\u3093\u3056\u3093 \u3042\u305D\u3093\u3060"
  - "\u3080\u3057\u305A\u3082\u3046\u306F \u5927\u304D\u3055 \u3058\u3083\u306A\u3044\u3002\u3042\u308C\u306F
    \u6C17\u5408\u3044\u3060"
  linesGe:
  - "\u671D\u3070\u3093\u304C \u3059\u305A\u3057\u304F \u306A\u3063\u305F\u3002\u3082\u3046
    \u79CB\u3060\u306A"
  - "\u3068\u3093\u307C\u304C \u5897\u3048\u305F\u308D\u3002\u3042\u308C\u304C \u51FA\u308B\u3068
    \u590F\u306F \u304A\u3057\u307E\u3044\u3060"
  - "\u5BBF\u984C\u3001\u307E\u3060 \u306A\u3093\u3060\u308D\u3002\u9854\u306B \u66F8\u3044\u3066
    \u3042\u308B\u305E"
  - "\u6765\u5E74\u3082 \u6765\u308B\u3093\u3060\u308D\uFF1F \u7551\u3001\u305D\u306E\u307E\u307E\u306B
    \u3057\u3066 \u304A\u304F\u304B\u3089\u306A"
