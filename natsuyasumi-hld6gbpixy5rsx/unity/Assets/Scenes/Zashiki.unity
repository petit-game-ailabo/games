  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Npc
  who: "\u3060\u3044\u3088\u3046\u305B\u3044"
  range: 2.8
  lines:
  - "\u3042\u3001\u307E\u308A\u3055\u3055\u3093\u3002\u2026\u2026\u304D\u3087\u3046\u3082
    \u5DDD\u3001\u304D\u308C\u3044\u3067\u3059\u306D"
  - "\u308F\u305F\u3057\u3001\u304A\u3088\u3052\u306A\u3044\u3093\u3067\u3059\u3002\u306A\u3044\u3057\u3087
    \u3067\u3059\u3088\uFF1F"
  - "\u3055\u3063\u304D \u304A\u304A\u304D\u306A \u3055\u304B\u306A\u304C \u3044\u307E\u3057\u305F\u3002\u307B\u3093\u3068\u3046\u3067\u3059"
  - "\u3080\u3057\u305A\u3082\u3046\u3001\u3053\u308F\u3044\u304B\u3089 \u307F\u3066\u308B
    \u3060\u3051\u3067 \u3044\u3044\u3067\u3059\u2026\u2026"
  - "\u3053\u306E \u5DDD\u3001\u305A\u3063\u3068 \u3055\u304D\u306F \u6D77\u306B
    \u3064\u3065\u3044\u3066 \u3044\u308B\u3093\u3067\u3059\u3063\u3066"
  linesJo:
  - "\u3042\u3001\u307E\u308A\u3055\u3055\u3093\u3002\u2026\u2026\u304D\u3087\u3046\u3082
    \u5DDD\u3001\u304D\u308C\u3044\u3067\u3059\u306D"
  - "\u308F\u305F\u3057\u3001\u304A\u3088\u3052\u306A\u3044\u3093\u3067\u3059\u3002\u306A\u3044\u3057\u3087
    \u3067\u3059\u3088\uFF1F"
  - "\u3055\u3063\u304D \u304A\u304A\u304D\u306A \u3055\u304B\u306A\u304C \u3044\u307E\u3057\u305F\u3002\u307B\u3093\u3068\u3046\u3067\u3059"
  - "\u3080\u3057\u305A\u3082\u3046\u3001\u3053\u308F\u3044\u304B\u3089 \u307F\u3066\u308B
    \u3060\u3051\u3067 \u3044\u3044\u3067\u3059\u2026\u2026"
  - "\u3053\u306E \u5DDD\u3001\u305A\u3063\u3068 \u3055\u304D\u306F \u6D77\u306B
    \u3064\u3065\u3044\u3066 \u3044\u308B\u3093\u3067\u3059\u3063\u3066"
  - "\u77F3\u3092 \u3072\u3063\u304F\u308A\u304B\u3048\u3059\u3068\u3001\u5C0F\u3055\u3044
    \u306E\u304C \u3044\u3063\u3071\u3044 \u3044\u307E\u3059"
  linesChu:
  - "\u6C34\u304C \u3059\u3053\u3057 \u3064\u3081\u305F\u304F \u306A\u308A\u307E\u3057\u305F\u3002\u2026\u2026\u6C17\u306E
    \u305B\u3044 \u3067\u3057\u3087\u3046\u304B"
  - "\u304D\u306E\u3046\u3001\u307B\u305F\u308B\u3092 \u898B\u307E\u3057\u305F\u3002\u3082\u3046
    \u5C11\u306A\u304F \u306A\u308A\u307E\u3057\u305F\u3051\u3069"
  - "\u307E\u308A\u3055\u3055\u3093\u3001\u3044\u3064\u3082 \u5143\u6C17\u3067\u3059\u306D\u3002\u2026\u2026\u3046\u3089\u3084\u307E\u3057\u3044\u3067\u3059"
  - "\u3068\u3046\u308D\u3046\u3001\u304D\u308C\u3044\u3067\u3057\u305F\u306D\u3002\u308F\u305F\u3057\u3001\u305A\u3063\u3068
    \u898B\u3066 \u3044\u307E\u3057\u305F"
  linesGe:
  - "\u3068\u3093\u307C\u304C \u3075\u3048\u307E\u3057\u305F\u306D\u3002\u2026\u2026\u590F\u3001\u304A\u308F\u3063\u3061\u3083\u3044\u307E\u3059\u306D"
  - "\u5915\u304C\u305F\u304C\u3001\u306F\u3084\u304F \u306A\u308A\u307E\u3057\u305F"
  - "\u308F\u305F\u3057\u3001\u3053\u3053\u306B \u305A\u3063\u3068 \u3044\u307E\u3059\u304B\u3089\u3002\u3044\u3064\u3067\u3082
    \u6765\u3066 \u304F\u3060\u3055\u3044"
  - "\u2026\u2026\u3042\u306E\u3001\u3053\u3093\u3069 \u6765\u308B \u3068\u304D\u3001\u307E\u305F
    \u3053\u3048\u3092 \u304B\u3051\u3066 \u304F\u3060\u3055\u3044\u306D"
  morning:
  - "\u304A\u306F\u3088\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u2026\u2026\u3042\u3001\u304A\u304D\u3066\u307E\u3057\u305F\uFF1F"
  night:
  - "\u304F\u3089\u3044\u3068 \u3061\u3087\u3063\u3068 \u3053\u308F\u3044\u3067\u3059\u3002\u3082\u3046
    \u304B\u3048\u308A\u307E\u3059\uFF1F"
  rain:
  - "\u3042\u3081\u306E \u65E5\u306E \u5DDD\u306F \u3053\u308F\u3044\u3067\u3059\u3002\u3061\u304B\u3065\u304B\u306A\u3044\u3067
    \u304F\u3060\u3055\u3044\u306D"
  manyBugs:
  - "\u305D\u3093\u306A\u306B \u3068\u3063\u3066\u2026\u2026\u306B\u304C\u3057\u3066
    \u3042\u3052\u3066 \u304F\u3060\u3055\u3044\u306D\uFF1F"
