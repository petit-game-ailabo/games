  range: 2.6
  lines:
  - "\u4E95\u6238\u306E \u6C34\u306F \u3064\u3081\u305F\u3044 \u3088\u3002\u3059\u3044\u304B
    \u3072\u3084\u3057\u3066 \u3042\u308B\u304B\u3089\u306D"
  - "\u305B\u3093\u305F\u304F\u3082\u306E\u3001\u305D\u3053\u306B \u307B\u3057\u3066
    \u3042\u308B\u304B\u3089 \u3055\u308F\u3089\u306A\u3044\u3067\u306D"
