  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Npc
  who: "\u304A\u3070\u3055\u3093"
  range: 2.6
  lines:
  - "\u4E95\u6238\u306E \u6C34\u306F \u3064\u3081\u305F\u3044 \u3088\u3002\u3059\u3044\u304B
    \u3072\u3084\u3057\u3066 \u3042\u308B\u304B\u3089\u306D"
  - "\u305B\u3093\u305F\u304F\u3082\u306E\u3001\u305D\u3053\u306B \u307B\u3057\u3066
    \u3042\u308B\u304B\u3089 \u3055\u308F\u3089\u306A\u3044\u3067\u306D"
  - "\u7960\u306E \u307B\u3046\u3078 \u884C\u304F\u306A\u3089 \u304A\u53C2\u308A
    \u3057\u3066 \u304A\u3044\u3067"
  linesJo:
  - "\u4E95\u6238\u306E \u6C34\u306F \u3064\u3081\u305F\u3044 \u3088\u3002\u3059\u3044\u304B
    \u3072\u3084\u3057\u3066 \u3042\u308B\u304B\u3089\u306D"
  - "\u305B\u3093\u305F\u304F\u3082\u306E\u3001\u305D\u3053\u306B \u307B\u3057\u3066
    \u3042\u308B\u304B\u3089 \u3055\u308F\u3089\u306A\u3044\u3067\u306D"
  - "\u7960\u306E \u307B\u3046\u3078 \u884C\u304F\u306A\u3089 \u304A\u53C2\u308A
    \u3057\u3066 \u304A\u3044\u3067"
  - "\u3051\u3055\u3001\u306B\u308F\u3068\u308A\u304C \u305F\u307E\u3054\u3092 3\u3064
    \u7523\u3093\u3060\u3088"
  - "\u6CE5\u3060\u3089\u3051\u3067 \u5E30\u3063\u3066 \u304A\u3044\u3067\u3002\u305D\u308C\u304C
    \u590F\u3060\u3088"
  linesChu:
  - "\u3064\u3051\u3082\u306E\u3001\u305D\u308D\u305D\u308D \u98DF\u3079\u3054\u308D
    \u3060\u3088"
  - "\u304D\u3087\u3046\u306F \u98A8\u304C \u3042\u308B \u304B\u3089\u3001\u3088\u304F
    \u304B\u308F\u304F \u306D\u3048"
  - "\u5915\u304C\u305F\u306E \u98A8\u308D\u3001\u305F\u304D\u3064\u3051\u3066 \u304A\u3044\u305F\u304B\u3089\u306D"
  - "\u305D\u3046\u3044\u3048\u3070\u3001\u5DDD\u3067 \u5927\u304D\u3044 \u3055\u304B\u306A\u3092
    \u898B\u305F \u4EBA\u304C \u3044\u308B\u3089\u3057\u3044\u3088"
  linesGe:
  - "\u591C\u3001\u307E\u3069\u3092 \u958B\u3051\u3063\u3071\u306A\u3057\u3067 \u5BDD\u308B\u3093\u3058\u3083
    \u306A\u3044\u3088\u3002\u51B7\u3048\u308B\u304B\u3089\u306D"
  - "\u304A\u307F\u3084\u3052\u306B \u3064\u3051\u3082\u306E\u3001\u6301\u3063\u3066
    \u3044\u304F\u304B\u3044\uFF1F"
