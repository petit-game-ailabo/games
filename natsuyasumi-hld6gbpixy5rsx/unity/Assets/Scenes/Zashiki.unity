  who: "\u304A\u3058\u3055\u3093"
  range: 2.6
  lines:
  - "\u7551\u306E \u304D\u3085\u3046\u308A\u3001\u3082\u3044\u3067 \u3044\u3063\u3066
    \u3044\u3044\u305E"
  - "\u304D\u3087\u3046\u306F \u8349\u3068\u308A\u3060\u3002\u624B\u3064\u3060\u3046\u304B\uFF1F
    \u2026\u2026\u3044\u3084\u3001\u3042\u305D\u3093\u3067 \u304D\u306A"
  - "\u5C71\u306E \u4E0A\u307E\u3067 \u884C\u304F\u306A\u3089\u3001\u65E5\u304C \u304F\u308C\u308B
    \u524D\u306B \u5E30\u308C\u3088"
  - "\u3053\u306E \u3078\u3093\u306F \u30AB\u30D6\u30C8\u30E0\u30B7\u304C \u591A\u3044\u3002\u96D1\u6728\u6797\u3092
    \u3055\u304C\u3057\u3066 \u307F\u308D"
